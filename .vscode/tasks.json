{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Compilar",
      "type": "shell",
      "command": "make",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ],
      "options": {
        "cwd": "${workspaceFolder}/server"
      },
      "windows": {
        "command": "mingw32-make"
      }
    },
    {
      "label": "Probar",
      "type": "shell",
      "command": "make",
      "group": "test",
      "problemMatcher": [
        "$gcc"
      ],
      "options": {
        "cwd": "${workspaceFolder}/server"
      },
      "windows": {
        "command": "mingw32-make"
      },
      "args": [
        "test"
      ]
    }
  ]
}
